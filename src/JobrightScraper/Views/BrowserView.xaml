<UserControl x:Class="JobrightScraper.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#F8FAFC"
                Padding="12"
                BorderBrush="#D5DEE7"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Open Jobright"
                            Command="{Binding OpenJobrightCommand}"/>
                    <Button Content="I'm logged in"
                            Command="{Binding ConfirmLoginCommand}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Status}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CurrentUrl}"
                               Foreground="{StaticResource MutedText}"
                               Margin="0,4,16,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <wv2:WebView2 x:Name="Browser"/>
    </DockPanel>
</UserControl>
